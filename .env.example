# Database
DATABASE_URL=postgresql+psycopg://short_factory:short_factory@localhost:5432/short_factory

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO local)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=short-factory
S3_REGION=us-east-1

# LLM providers (at least one required for research/scripts)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Reddit (praw)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=short-factory/0.1

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_DRY_RUN=true

# TTS
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
OPENAI_TTS_VOICE=alloy

# Stock visuals
PEXELS_API_KEY=

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
RENDER_DIR=/tmp/renders
VIRALITY_THRESHOLD=0.6
TOPICS_PER_SCRAPE=50
